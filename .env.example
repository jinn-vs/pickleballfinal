# ── Supabase (site reads published content with the anon key) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Canonical site URL (used for metadata, OG, sitemap, RSS) ──
NEXT_PUBLIC_SITE_URL=https://pickleballreads.com

# ── Optional: instant cache purge via Supabase webhook → POST /api/revalidate ──
REVALIDATE_SECRET=
